# Secret/local deploy configuration
STACK_NAME=ost-simple-sts
POLICY_REPOSITORY=example-org/example-repo
POLICY_REPOSITORY_ID=789012
POLICY_INSTALLATION_ID=456789
POLICY_PATH=.github/ost-simple-sts.json
POLICY_REF=main
# Optional custom OIDC audience; defaults to the deployed API URL
# POLICY_AUDIENCE=https://simple-sts.example.com
APP_ID=1234567
APP_ID_PARAMETER=/ost/app-id
APP_PRIVATE_KEY_SECRET_NAME=ost/app-private-key
# Preferred: point to a local PEM file
APP_PRIVATE_KEY_FILE=.secrets/github-app-private-key.pem
# Fallback: inline escaped PEM value
# APP_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n'
JTI_TABLE_NAME=ost-jti-replay
# Optional KMS key from the ost-github-proxy stack's CapabilityKeyArn output
# PROXY_CAPABILITY_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/example
# Optional SNS topic for CloudWatch alarm notifications
# ALARM_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:security-alerts
