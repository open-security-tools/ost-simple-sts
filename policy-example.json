{
  "version": 2,
  "repositories": {
    "example-repo": {
      "name": "example-org/example-repo",
      "id": 789012,
      "oidc_subject": "immutable",
      "owner_id": 123456
    }
  },
  "rules": [
    {
      "caller": "example-repo",
      "environment": "release",
      "caller_workflow": "release.yml",
      "on": ["workflow_dispatch"],
      "permissions": { "contents": "write" },
      "target": "example-repo"
    }
  ]
}
